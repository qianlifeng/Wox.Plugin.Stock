{
  "Id": "074ff6c9-50d1-4c26-9583-c6e48b3c48f2",
  "TriggerKeywords": [
    "stock",
    "gp"
  ],
  "Name": "i18n:plugin_name",
  "Description": "i18n:plugin_description",
  "Author": "qianlifeng",
  "Version": "0.0.9",
  "MinWoxVersion": "2.5.0",
  "Runtime": "nodejs",
  "Website": "https://github.com/qianlifeng/Wox.Plugin.Stock",
  "Entry": "index.js",
  "Icon": "relative:images/app.png",
  "SupportedOS": [
    "windows",
    "linux",
    "darwin"
  ],
  "Features": [
    {
      "Name": "debounce",
      "Params": {
        "IntervalMs": 300
      }
    },
    {
      "Name": "ignoreAutoScore"
    },
    {
      "Name": "mru",
      "Params": {
        "HashBy": "identityKey"
      }
    }
  ],
  "SettingDefinitions": [
    {
      "Type": "table",
      "Value": {
        "Key": "watchlist",
        "DefaultValue": "[]",
        "Title": "i18n:setting_watchlist",
        "Tooltip": "i18n:setting_watchlist_tip",
        "MaxHeight": 360,
        "InlineTable": true,
        "Columns": [
          {
            "Key": "name",
            "Label": "i18n:column_name",
            "Type": "text",
            "Width": 140
          },
          {
            "Key": "code",
            "Label": "i18n:column_code",
            "Type": "text",
            "Width": 110,
            "Validators": [
              {
                "Type": "not_empty",
                "Value": {}
              }
            ]
          },
          {
            "Key": "market",
            "Label": "i18n:column_market",
            "Type": "select",
            "Width": 120,
            "Validators": [
              {
                "Type": "not_empty",
                "Value": {}
              }
            ],
            "SelectOptions": [
              {
                "Label": "i18n:market_a",
                "Value": "a"
              },
              {
                "Label": "i18n:market_hk",
                "Value": "hk"
              },
              {
                "Label": "i18n:market_us",
                "Value": "us"
              }
            ]
          },
          {
            "Key": "quoteId",
            "Label": "i18n:column_quote_id",
            "Tooltip": "i18n:column_quote_id_tip",
            "Type": "text",
            "Width": 140,
            "HideInTable": true
          }
        ]
      },
      "IsPlatformSpecific": false
    }
  ],
